import hxp.*;
import lime.tools.*;
import haxe.Json;
import haxe.io.Path;
import sys.FileSystem;
import sys.io.File;

class Project extends HXProject
{
	static inline var APP_TITLE:String = "Shark";
	static inline var APP_PACKAGE:String = "com.brenninho.shark";
	static inline var APP_VERSION:String = "0.1.0";
	static inline var APP_COMPANY:String = "Brenninho";
	static inline var DEV_BRANCH_NAME:String = "dev";
	static inline var STAGING_BRANCH_NAME:String = "staging";
	static inline var MAIN_BRANCH_NAME:String = "main";
	static inline var ASTC_WARN_THRESHOLD_BYTES:Int = 400000;
	static inline var ASSET_WARN_THRESHOLD_BYTES:Int = 250000000;

	var isDevBranch:Bool;
	var isStagingBranch:Bool;
	var isMainBranch:Bool;
	var gitBranch:String;
	var isGitAvailable:Bool = true;
	var sharkEnvironment:String;
	var envVars:Map<String, String> = new Map();
	var activeFeatures:Array<String> = [];
	var buildWarnings:Array<String> = [];
	var buildStartTime:Float;

	public function new()
	{
		super();

		buildStartTime = Sys.time();

		loadEnvFile();

		gitBranch = resolveGitBranch();
		isDevBranch = gitBranch == DEV_BRANCH_NAME;
		isStagingBranch = gitBranch == STAGING_BRANCH_NAME;
		isMainBranch = gitBranch == MAIN_BRANCH_NAME;
		sharkEnvironment = resolveEnvironment();

		setupMeta();
		setupApp();
		setupWindow();
		setupSource();
		setupHaxelibs();
		setupAssets();
		setupIcon();
		setupLocalization();
		setupFeatureFlags();
		setupDefines();
		setupOptimizations();

		checkConfigJson();
		checkDependencyIntegrity();
		validateAssetIntegrity();

		switch (target)
		{
			case WINDOWS:
				setupWindows();
			case ANDROID:
				setupAndroid();
			case IOS:
				setupIOS();
			case HTML5:
				setupHTML5();
			case LINUX:
				setupLinux();
			case MAC:
				setupMac();
			default:
				buildWarnings.push('Unrecognized target "$target" - no platform-specific setup applied.');
		}

		setupDevMode();
		setupStagingMode();
		setupProductionMode();

		writeBuildInfo();
		maybeCreateGitTag();

		logBuildSummary();
	}

	function loadEnvFile():Void
	{
		var candidates:Array<String> = [".env", ".env.local"];

		for (path in candidates)
		{
			if (!FileSystem.exists(path))
				continue;

			try
			{
				var lines:Array<String> = File.getContent(path).split("\n");

				for (rawLine in lines)
				{
					var line:String = StringTools.trim(rawLine);

					if (line.length == 0 || StringTools.startsWith(line, "#"))
						continue;

					var separatorIndex:Int = line.indexOf("=");

					if (separatorIndex == -1)
						continue;

					var key:String = StringTools.trim(line.substr(0, separatorIndex));
					var value:String = StringTools.trim(line.substr(separatorIndex + 1));

					if (value.length >= 2 && StringTools.startsWith(value, "\"") && StringTools.endsWith(value, "\""))
						value = value.substr(1, value.length - 2);

					envVars.set(key, value);
				}
			}
			catch (e:Dynamic)
			{
				buildWarnings.push('Failed to parse $path - ignoring it.');
			}
		}
	}

	function envOr(name:String, fallback:String):String
	{
		var systemValue:String = Sys.getEnv(name);

		if (systemValue != null && systemValue.length > 0)
			return systemValue;

		if (envVars.exists(name))
		{
			var localValue:String = envVars.get(name);

			if (localValue != null && localValue.length > 0)
				return localValue;
		}

		return fallback;
	}

	function resolveEnvironment():String
	{
		var explicit:String = envOr("SHARK_ENV", "");

		if (explicit == "dev" || explicit == "staging" || explicit == "production")
			return explicit;

		if (isMainBranch)
			return "production";

		if (isStagingBranch)
			return "staging";

		return "dev";
	}

	function checkConfigJson():Void
	{
		var path:String = "assets/data/config.json";

		if (!FileSystem.exists(path))
		{
			buildWarnings.push('$path not found - run `haxe --run setup/application/Setup.hx` first, or the chat/image API will not be configured.');
			return;
		}

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));
			var requiredKeys:Array<String> = ["chatApiEndpoint", "imageApiEndpoint", "apiTimeoutSeconds"];

			for (key in requiredKeys)
			{
				if (!Reflect.hasField(parsed, key))
					buildWarnings.push('$path is missing required field "$key".');
			}
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but is not valid JSON - the chat/image API may fail to configure at runtime.');
		}
	}

	function checkDependencyIntegrity():Void
	{
		var required:Array<String> = ["lime", "openfl", "flixel", "flixel-addons", "hscript", "polymod"];
		var missing:Array<String> = [];

		try
		{
			var process = new sys.io.Process("haxelib", ["list"]);
			var output:String = process.stdout.readAll().toString();
			process.close();

			for (lib in required)
				if (output.indexOf(lib) == -1)
					missing.push(lib);
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Could not run `haxelib list` to verify installed dependencies - skipping integrity check.");
			return;
		}

		if (missing.length > 0)
			buildWarnings.push('The following haxelibs appear to be missing locally: ${missing.join(", ")} - run `haxelib install <name>`.');
	}

	function validateAssetIntegrity():Void
	{
		if (!FileSystem.exists("assets/images/icon.png"))
			buildWarnings.push("assets/images/icon.png not found - the app icon will fail to package.");

		if (!FileSystem.exists("assets/images") || !FileSystem.isDirectory("assets/images") || FileSystem.readDirectory("assets/images").length == 0)
		{
			buildWarnings.push("assets/images is missing or empty.");
			return;
		}

		var totalSize:Int = 0;
		var uncompressedLargeTextures:Array<String> = [];

		scanDirectory("assets/images", function(fullPath:String, size:Int)
		{
			totalSize += size;

			if (StringTools.endsWith(fullPath, ".png") && size > ASTC_WARN_THRESHOLD_BYTES && (target == ANDROID || target == IOS))
				uncompressedLargeTextures.push(fullPath);
		});

		if (totalSize > ASSET_WARN_THRESHOLD_BYTES)
			buildWarnings.push('assets/images totals ${formatBytes(totalSize)}, which is unusually large - consider trimming unused assets.');

		if (uncompressedLargeTextures.length > 0)
			buildWarnings.push('${uncompressedLargeTextures.length} texture(s) over ${formatBytes(ASTC_WARN_THRESHOLD_BYTES)} are still raw PNG for a mobile target - consider ASTC compression: ${uncompressedLargeTextures.join(", ")}');
	}

	function scanDirectory(path:String, onFile:String->Int->Void):Void
	{
		if (!FileSystem.exists(path))
			return;

		for (entry in FileSystem.readDirectory(path))
		{
			var fullPath:String = '$path/$entry';

			if (FileSystem.isDirectory(fullPath))
			{
				scanDirectory(fullPath, onFile);
				continue;
			}

			try
			{
				onFile(fullPath, FileSystem.stat(fullPath).size);
			}
			catch (e:Dynamic) {}
		}
	}

	function formatDecimal(value:Float, decimals:Int):String
	{
		var factor:Float = Math.pow(10, decimals);
		var rounded:Float = Math.round(value * factor) / factor;
		var text:String = Std.string(rounded);

		if (text.indexOf(".") == -1)
			text += ".0";

		return text;
	}

	function formatBytes(bytes:Int):String
	{
		if (bytes >= 1000000)
			return formatDecimal(bytes / 1000000, 2) + " MB";

		if (bytes >= 1000)
			return formatDecimal(bytes / 1000, 2) + " KB";

		return '$bytes B';
	}

	function logBuildSummary():Void
	{
		var devTag:String = isDevBranch ? " [DEV BRANCH]" : "";
		var elapsed:Float = Sys.time() - buildStartTime;

		Log.info('Shark ${meta.version} (build ${meta.buildNumber}, commit ${haxedefs.get("SHARK_COMMIT")}, branch $gitBranch, env $sharkEnvironment) -> $target, ${debug ? "debug" : "release"}$devTag');

		if (!isGitAvailable)
			Log.warn("git was not found or this is not a git repository - commit hash, branch, and tag/working-tree checks fell back to defaults.");

		if (activeFeatures.length > 0)
			Log.info('Active optional features for this build: ${activeFeatures.join(", ")}');

		if (buildWarnings.length > 0)
		{
			Log.warn('${buildWarnings.length} warning(s) collected during project setup:');

			for (warning in buildWarnings)
				Log.warn('  - $warning');
		}

		Log.info('Project.hxp setup finished in ${formatDecimal(elapsed, 3)}s');
	}

	function setupMeta():Void
	{
		meta.title = APP_TITLE;
		meta.description = "An artificial intelligence made with HaxeFlixel.";
		meta.packageName = APP_PACKAGE;
		meta.version = resolveVersion();
		meta.company = APP_COMPANY;
		meta.buildNumber = resolveBuildNumber();
	}

	function resolveVersion():String
	{
		if (FileSystem.exists("VERSION"))
		{
			var content:String = StringTools.trim(File.getContent("VERSION"));

			if (content.length > 0)
			{
				if (!isValidVersionFormat(content))
					buildWarnings.push('VERSION file contains "$content", which does not look like a semver string (e.g. 1.2.3) - using it anyway.');

				return content;
			}
		}

		return APP_VERSION;
	}

	function isValidVersionFormat(value:String):Bool
	{
		var parts:Array<String> = value.split(".");

		if (parts.length < 2 || parts.length > 3)
			return false;

		for (part in parts)
			if (Std.parseInt(part) == null)
				return false;

		return true;
	}

	function setupApp():Void
	{
		app.main = "Main";
		app.file = APP_TITLE;
		app.path = "export";
	}

	function setupWindow():Void
	{
		window.width = 1280;
		window.height = 720;
		window.fps = 60;
		window.background = 0x00111F;
		window.hardware = true;
		window.vsync = false;
		window.antialiasing = 0;
		window.allowShaders = true;
	}

	function setupSource():Void
	{
		sources.push("source");
	}

	function setupHaxelibs():Void
	{
		var pinned:Map<String, String> = loadPinnedVersions();

		addHaxelib("lime", pinned);
		addHaxelib("openfl", pinned);
		addHaxelib("flixel", pinned);
		addHaxelib("flixel-addons", pinned);
		addHaxelib("flixel-ui", pinned);
		addHaxelib("hscript", pinned);
		addHaxelib("SScript", pinned);

		if (debug)
		{
			addHaxelib("flixel-demos", pinned);
			activeFeatures.push("flixel-demos (debug reference)");
		}

		if (target != HTML5)
		{
			addHaxelib("hxdiscord_rpc", pinned);
			activeFeatures.push("Discord Rich Presence");
		}

		if (target == ANDROID)
		{
			addHaxelib("extension-androidtools", pinned);
			activeFeatures.push("Android native tools");
		}

		addHaxelib("polymod", pinned);
		activeFeatures.push("Polymod");

		if (target == WINDOWS || target == MAC || target == LINUX || target == ANDROID || target == IOS)
		{
			addHaxelib("hxvlc", pinned);
			activeFeatures.push("Video playback (hxvlc)");
		}

		addHaxelib("hxmath", pinned);
		haxedefs.set("HXMATH_USE_OPENFL_STRUCTURES", "");

		addHaxelib("haxeui-core", pinned);
		addHaxelib("haxeui-flixel", pinned);
		activeFeatures.push("HaxeUI");

		addHaxelib("newgrounds", pinned);
		activeFeatures.push("Newgrounds API");

		if (target == ANDROID || target == IOS)
		{
			addHaxelib("extension-admob", pinned);
			activeFeatures.push("AdMob");

			if (target == ANDROID)
				config.set("android.setenv.ADMOB_APPID", envOr("SHARK_ADMOB_APPID_ANDROID", "ca-app-pub-3940256099942544~3347511713"));

			if (target == IOS)
				config.set("ios.setenv.ADMOB_APPID", envOr("SHARK_ADMOB_APPID_IOS", "ca-app-pub-3940256099942544~1458002511"));
		}

		if (target == LINUX)
		{
			addHaxelib("hxgamemode", pinned);
			activeFeatures.push("Linux GameMode");
		}

		addHaxelib("flxanimate", pinned);

		if (!debug && sharkEnvironment != "production" && envOr("SHARK_SENTRY_DSN", "").length > 0)
		{
			addHaxelib("sentry", pinned);
			activeFeatures.push("Crash reporting (Sentry)");
		}

		if (debug)
		{
			addHaxelib("munit", pinned);
			addHaxelib("mconsole", pinned);
			activeFeatures.push("Unit testing (munit, debug only)");

			if (envOr("SHARK_COVERAGE", "") == "1")
			{
				addHaxelib("mcover", pinned);
				haxeflags.push("--macro mcover.MCover.instrument()");
				activeFeatures.push("Code coverage (mcover)");
			}
		}
	}

	function loadPinnedVersions():Map<String, String>
	{
		var pinned:Map<String, String> = new Map();
		var path:String = "haxelib_versions.json";

		if (!FileSystem.exists(path))
			return pinned;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));

			for (field in Reflect.fields(parsed))
				pinned.set(field, Reflect.field(parsed, field));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but could not be parsed - ignoring version pins.');
		}

		return pinned;
	}

	function addHaxelib(name:String, pinned:Map<String, String>):Void
	{
		if (pinned.exists(name))
		{
			haxelibs.push(new Haxelib(name, pinned.get(name)));
			return;
		}

		haxelibs.push(new Haxelib(name));
	}

	function setupAssets():Void
	{
		includeAssets("assets/images", "assets/images");
		includeAssets("assets/data", "assets/data");

		if (FileSystem.exists("assets/fonts") && FileSystem.readDirectory("assets/fonts").length > 0)
			includeAssets("assets/fonts", "assets/fonts");

		if (FileSystem.exists("assets/shaders") && FileSystem.readDirectory("assets/shaders").length > 0)
			includeAssets("assets/shaders", "assets/shaders");

		setupMods();
	}

	function setupMods():Void
	{
		if (target == HTML5)
			return;

		if (!FileSystem.exists("mods") || !FileSystem.isDirectory("mods"))
			return;

		var entries:Array<String> = FileSystem.readDirectory("mods");

		if (entries.length == 0)
			return;

		var scriptModCount:Int = 0;
		var folderModCount:Int = 0;

		for (entry in entries)
		{
			var fullPath:String = 'mods/$entry';

			if (FileSystem.isDirectory(fullPath))
				folderModCount++;
			else if (StringTools.endsWith(entry, ".hxs"))
				scriptModCount++;
		}

		includeAssets("mods", "mods");
		haxedefs.set("SHARK_HAS_BUNDLED_MODS", "");

		setupPolymodDefines();

		activeFeatures.push('Bundled mods ($scriptModCount script, $folderModCount folder)');
		Log.info('Bundled mods folder detected: $scriptModCount .hxs script mod(s), $folderModCount Polymod folder mod(s) - packaging with the app.');
	}

	function setupPolymodDefines():Void
	{
		haxedefs.set("POLYMOD_SCRIPT_EXT", "hxs");

		if (debug)
			haxedefs.set("POLYMOD_DEBUG", "");
	}

	function setupLocalization():Void
	{
		var path:String = "assets/data/locales";

		if (!FileSystem.exists(path) || !FileSystem.isDirectory(path))
			return;

		var locales:Array<String> = [];

		for (entry in FileSystem.readDirectory(path))
			if (StringTools.endsWith(entry, ".json"))
				locales.push(Path.withoutExtension(entry));

		if (locales.length == 0)
			return;

		includeAssets(path, "assets/data/locales");
		haxedefs.set("SHARK_LOCALES", locales.join(","));
		haxedefs.set("SHARK_DEFAULT_LOCALE", envOr("SHARK_DEFAULT_LOCALE", locales.indexOf("en") != -1 ? "en" : locales[0]));

		activeFeatures.push('Localization (${locales.length} locale(s): ${locales.join(", ")})');
	}

	function setupFeatureFlags():Void
	{
		var path:String = "assets/data/features.json";

		if (!FileSystem.exists(path))
			return;

		try
		{
			var parsed:Dynamic = Json.parse(File.getContent(path));

			for (field in Reflect.fields(parsed))
			{
				var enabled:Dynamic = Reflect.field(parsed, field);

				if (enabled == true)
				{
					haxedefs.set('SHARK_FEATURE_${field.toUpperCase()}', "");
					activeFeatures.push('Feature flag: $field');
				}
			}
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('$path exists but could not be parsed - no feature flags applied.');
		}
	}

	function setupIcon():Void
	{
		icons.push(new Icon("assets/images/icon.png"));
	}

	function setupDefines():Void
	{
		if (!debug)
		{
			haxedefs.set("FLX_NO_DEBUG", "");
			haxedefs.set("FLX_NO_FOCUS_LOST_SCREEN", "");
		}

		haxedefs.set("SHARK_VERSION", APP_VERSION);
		haxedefs.set("SHARK_COMMIT", resolveGitCommit());
		haxedefs.set("SHARK_ENVIRONMENT", sharkEnvironment);
		haxedefs.set("SHARK_BUILD_TIMESTAMP", Std.string(Std.int(Date.now().getTime() / 1000)));

		var sentryDsn:String = envOr("SHARK_SENTRY_DSN", "");

		if (sentryDsn.length > 0)
			haxedefs.set("SHARK_SENTRY_DSN", sentryDsn);
		else if (sharkEnvironment == "production")
			buildWarnings.push("No SHARK_SENTRY_DSN set for a production build - crash reporting will be disabled.");
	}

	function setupOptimizations():Void
	{
		if (!debug)
		{
			haxeflags.push("-dce full");
			haxeflags.push("-D no-traces");
			haxeflags.push("-D analyzer-optimize");
		}
	}

	function setupWindows():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "windows");

		if (!debug)
		{
			haxeflags.push("-dce full");
			haxeflags.push("-D no-traces");

			if (envOr("SHARK_SIGN_WINDOWS", "") != "1")
				buildWarnings.push("SHARK_SIGN_WINDOWS is not set to 1 - the Windows build will not be code-signed.");
		}

		cleanIfRequested("windows");
	}

	function setupAndroid():Void
	{
		window.orientation = LANDSCAPE;
		window.fullscreen = true;
		window.hardware = true;

		architectures = [Architecture.ARMV7, Architecture.ARM64];

		haxedefs.set("SHARK_PLATFORM", "android");
		haxedefs.set("FLX_NO_NATIVE_CURSOR", "");
		haxedefs.set("FLX_NO_SOUND_TRAY", "");

		var permissions:Array<String> = [
			"android.permission.INTERNET",
			"android.permission.WRITE_EXTERNAL_STORAGE",
			"android.permission.READ_EXTERNAL_STORAGE",
			"android.permission.RECORD_AUDIO",
			"android.permission.READ_MEDIA_IMAGES",
			"android.permission.READ_MEDIA_AUDIO",
			"android.permission.FOREGROUND_SERVICE"
		];

		config.set("android.permissions", permissions.join(" "));
		config.set("android.target-sdk-version", "35");
		config.set("android.minimum-sdk-version", "21");
		config.set("android.install-location", "auto");
		config.set("android.window-soft-input-mode", "adjustResize");
		config.set("android.version-code", meta.buildNumber);

		if (!debug)
		{
			var keystoreProfile:String = envOr("SHARK_KEYSTORE_PROFILE", "default");
			var keystorePathKey:String = keystoreProfile == "default" ? "SHARK_KEYSTORE_PATH" : 'SHARK_KEYSTORE_PATH_${keystoreProfile.toUpperCase()}';

			config.set("android.certificate-path", envOr(keystorePathKey, "Certificates/android.keystore"));
			config.set("android.certificate-password", envOr("SHARK_KEYSTORE_PASSWORD", "android"));
			config.set("android.certificate-alias", envOr("SHARK_KEYSTORE_ALIAS", "android"));
			config.set("android.certificate-alias-password", envOr("SHARK_KEYSTORE_ALIAS_PASSWORD", "android"));

			if (!FileSystem.exists(config.get("android.certificate-path")))
				buildWarnings.push('Android keystore not found at "${config.get("android.certificate-path")}" - the release build will fail to sign.');
		}
	}

	function setupIOS():Void
	{
		window.orientation = LANDSCAPE;
		window.fullscreen = true;

		haxedefs.set("SHARK_PLATFORM", "ios");
		haxedefs.set("FLX_NO_NATIVE_CURSOR", "");
		haxedefs.set("FLX_NO_SOUND_TRAY", "");

		config.set("ios.deployment", "12.0");
		config.set("ios.device", "universal");
		config.set("ios.extension", "false");
		config.set("ios.build-number", meta.buildNumber);

		if (!debug && envOr("SHARK_IOS_TEAM_ID", "").length == 0)
			buildWarnings.push("SHARK_IOS_TEAM_ID is not set - Xcode signing may require manual configuration.");
	}

	function setupHTML5():Void
	{
		window.resizable = true;
		window.allowHighDPI = true;
		window.background = 0x00111F;

		haxedefs.set("SHARK_PLATFORM", "html5");

		config.set("html5.title", APP_TITLE);

		if (envOr("SHARK_PWA", "1") == "1")
		{
			writePwaManifest();
			activeFeatures.push("PWA manifest");
		}
	}

	function writePwaManifest():Void
	{
		var manifestPath:String = "assets/data/manifest.webmanifest";

		var manifest:Dynamic = {
			name: APP_TITLE,
			short_name: APP_TITLE,
			start_url: "./",
			display: "standalone",
			background_color: "#00111F",
			theme_color: "#00111F",
			icons: [{src: "assets/images/icon.png", sizes: "512x512", type: "image/png"}]
		};

		try
		{
			if (!FileSystem.exists("assets/data"))
				FileSystem.createDirectory("assets/data");

			File.saveContent(manifestPath, Json.stringify(manifest, null, "\t"));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write PWA manifest - HTML5 build will not be installable.");
		}
	}

	function setupLinux():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "linux");

		cleanIfRequested("linux");
	}

	function setupMac():Void
	{
		window.width = 1280;
		window.height = 720;
		window.resizable = true;
		window.background = 0x00111F;

		architectures = [Architecture.X64];

		haxedefs.set("SHARK_PLATFORM", "mac");

		if (!debug && envOr("SHARK_NOTARIZE_MAC", "") != "1")
			buildWarnings.push("SHARK_NOTARIZE_MAC is not set to 1 - the macOS build will not be notarized.");

		cleanIfRequested("mac");
	}

	function cleanIfRequested(platformFolder:String):Void
	{
		if (envOr("SHARK_CLEAN_BUILD", "") != "1")
			return;

		var exportPath:String = 'export/$platformFolder';

		if (FileSystem.exists(exportPath))
		{
			Log.info('SHARK_CLEAN_BUILD=1 -> removing $exportPath before build');
			deleteRecursive(exportPath);
		}
	}

	function deleteRecursive(path:String):Void
	{
		if (!FileSystem.exists(path))
			return;

		if (FileSystem.isDirectory(path))
		{
			for (entry in FileSystem.readDirectory(path))
				deleteRecursive('$path/$entry');

			FileSystem.deleteDirectory(path);
		}
		else
		{
			FileSystem.deleteFile(path);
		}
	}

	function setupDevMode():Void
	{
		if (sharkEnvironment != "dev")
			return;

		haxedefs.set("SHARK_DEV_MODE", "");

		meta.title = '$APP_TITLE (dev)';
		window.background = 0xFF2A0A0A;

		Log.info('Environment "dev" (branch "$gitBranch") - SHARK_DEV_MODE enabled (dev-only window tint, title suffix).');
	}

	function setupStagingMode():Void
	{
		if (sharkEnvironment != "staging")
			return;

		haxedefs.set("SHARK_STAGING_MODE", "");

		meta.title = '$APP_TITLE (staging)';
		window.background = 0xFF1A2A00;

		Log.info('Environment "staging" (branch "$gitBranch") - SHARK_STAGING_MODE enabled.');
	}

	function setupProductionMode():Void
	{
		if (sharkEnvironment != "production")
			return;

		haxedefs.set("SHARK_PRODUCTION", "");

		var checklist:Array<String> = [];
		var failures:Array<String> = [];

		checkProductionItem(checklist, failures, "config.json present", FileSystem.exists("assets/data/config.json"), !debug);
		checkProductionItem(checklist, failures, "VERSION format valid", isValidVersionFormat(meta.version), !debug);
		checkProductionItem(checklist, failures, "no leftover dev define", !haxedefs.exists("SHARK_DEV_MODE"), false);
		checkProductionItem(checklist, failures, "working tree clean (no uncommitted changes)", isWorkingTreeClean(), false);
		checkProductionItem(checklist, failures, "no merge conflict markers in source/", !hasMergeConflictMarkers(), true);
		checkProductionItem(checklist, failures, 'version "${meta.version}" has a matching git tag', hasMatchingGitTag(meta.version), false);
		checkProductionItem(checklist, failures, 'CHANGELOG.md mentions "${meta.version}"', changelogMentionsVersion(meta.version), false);
		checkProductionItem(checklist, failures, "no broken mod folders (missing _polymod_meta.json)", !hasIncompleteModFolders(), false);
		checkProductionItem(checklist, failures, "no unresolved setup warnings", buildWarnings.length == 0, false);

		if (target == ANDROID && !debug)
		{
			var keystorePath:String = envOr("SHARK_KEYSTORE_PATH", "Certificates/android.keystore");
			checkProductionItem(checklist, failures, 'Android keystore exists ($keystorePath)', FileSystem.exists(keystorePath), true);
		}

		if (!debug)
			checklist.push("[OK] release optimizations active (see setupOptimizations)");

		Log.info('Production checklist (branch "$MAIN_BRANCH_NAME"):\n  ' + checklist.join("\n  "));

		if (failures.length > 0 && !debug)
		{
			Log.error('Production build blocked - fix the following before building from $MAIN_BRANCH_NAME:\n  ' + failures.join("\n  "));
			Sys.exit(1);
		}
	}

	function checkProductionItem(checklist:Array<String>, failures:Array<String>, label:String, passed:Bool, isBlocking:Bool):Void
	{
		if (passed)
		{
			checklist.push('[OK] $label');
			return;
		}

		if (isBlocking)
		{
			checklist.push('[FAIL] $label');
			failures.push(label);
		}
		else
		{
			checklist.push('[WARN] $label');
		}
	}

	function isWorkingTreeClean():Bool
	{
		try
		{
			var process = new sys.io.Process("git", ["status", "--porcelain"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();

			return output.length == 0;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function hasMergeConflictMarkers():Bool
	{
		return directoryContainsMarker("source", "<<<<<<< ");
	}

	function directoryContainsMarker(path:String, marker:String):Bool
	{
		if (!FileSystem.exists(path))
			return false;

		for (entry in FileSystem.readDirectory(path))
		{
			var fullPath:String = '$path/$entry';

			if (FileSystem.isDirectory(fullPath))
			{
				if (directoryContainsMarker(fullPath, marker))
					return true;

				continue;
			}

			if (!StringTools.endsWith(entry, ".hx") && !StringTools.endsWith(entry, ".hxp"))
				continue;

			try
			{
				var content:String = File.getContent(fullPath);

				if (content.indexOf(marker) != -1)
					return true;
			}
			catch (e:Dynamic) {}
		}

		return false;
	}

	function hasMatchingGitTag(version:String):Bool
	{
		try
		{
			var process = new sys.io.Process("git", ["tag", "--list"]);
			var output:String = process.stdout.readAll().toString();
			process.close();

			return output.indexOf(version) != -1 || output.indexOf('v$version') != -1;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function changelogMentionsVersion(version:String):Bool
	{
		if (!FileSystem.exists("CHANGELOG.md"))
			return true;

		try
		{
			var content:String = File.getContent("CHANGELOG.md");
			return content.indexOf(version) != -1;
		}
		catch (e:Dynamic)
		{
			return true;
		}
	}

	function hasIncompleteModFolders():Bool
	{
		if (!FileSystem.exists("mods") || !FileSystem.isDirectory("mods"))
			return false;

		for (entry in FileSystem.readDirectory("mods"))
		{
			var fullPath:String = 'mods/$entry';

			if (!FileSystem.isDirectory(fullPath))
				continue;

			if (!FileSystem.exists('$fullPath/_polymod_meta.json'))
				return true;
		}

		return false;
	}

	function maybeCreateGitTag():Void
	{
		if (sharkEnvironment != "production" || debug || envOr("SHARK_AUTO_TAG", "") != "1")
			return;

		if (hasMatchingGitTag(meta.version))
			return;

		try
		{
			var process = new sys.io.Process("git", ["tag", 'v${meta.version}']);
			process.exitCode();
			process.close();

			Log.info('Created git tag v${meta.version}');
		}
		catch (e:Dynamic)
		{
			buildWarnings.push('SHARK_AUTO_TAG=1 but failed to create git tag v${meta.version}.');
		}
	}

	function writeBuildInfo():Void
	{
		var info:Dynamic = {
			title: meta.title,
			version: meta.version,
			buildNumber: meta.buildNumber,
			commit: haxedefs.get("SHARK_COMMIT"),
			branch: gitBranch,
			environment: sharkEnvironment,
			target: Std.string(target),
			debug: debug,
			features: activeFeatures,
			generatedAt: Std.int(Date.now().getTime() / 1000)
		};

		try
		{
			if (!FileSystem.exists("assets/data"))
				FileSystem.createDirectory("assets/data");

			File.saveContent("assets/data/build_info.json", Json.stringify(info, null, "\t"));
		}
		catch (e:Dynamic)
		{
			buildWarnings.push("Failed to write assets/data/build_info.json - runtime version info will be unavailable.");
		}
	}

	function resolveGitCommit():String
	{
		try
		{
			var process = new sys.io.Process("git", ["rev-parse", "--short", "HEAD"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			process.close();

			return output.length > 0 ? output : "unknown";
		}
		catch (e:Dynamic)
		{
			return "unknown";
		}
	}

	function resolveGitBranch():String
	{
		try
		{
			var process = new sys.io.Process("git", ["rev-parse", "--abbrev-ref", "HEAD"]);
			var output:String = StringTools.trim(process.stdout.readAll().toString());
			var exitCode:Int = process.exitCode();
			process.close();

			if (exitCode != 0)
			{
				isGitAvailable = false;
				return "unknown";
			}

			return output.length > 0 ? output : "unknown";
		}
		catch (e:Dynamic)
		{
			isGitAvailable = false;
			return "unknown";
		}
	}

	function resolveBuildNumber():String
	{
		var path:String = ".build_number";
		var current:Int = 0;

		try
		{
			if (FileSystem.exists(path))
				current = Std.parseInt(StringTools.trim(File.getContent(path)));

			if (current == null)
				current = 0;
		}
		catch (e:Dynamic)
		{
			current = 0;
		}

		current++;

		try
		{
			File.saveContent(path, Std.string(current));
		}
		catch (e:Dynamic) {}

		return Std.string(current);
	}
}
